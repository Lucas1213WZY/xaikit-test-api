    {
      "SurveyID": "SV_roRAccnu3Mj6I2j",
      "Element": "SQ",
      "PrimaryAttribute": "QID3",
      "SecondaryAttribute": "Practice trial 1 of 10 — instance 0 This is a practice round: you will see feedback after answering.",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionID": "QID3",
        "DataExportTag": "Q3",
        "QuestionType": "DB",
        "Selector": "TB",
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "QuestionDescription": "Practice trial 1 of 10 — instance 0 This is a practice round: you will see feedback after answering.",
        "QuestionText": "<div><strong>Practice trial 1 of 10</strong> — instance 0</div><p>This is a practice round: you will see feedback after answering. Study the interface below, then answer the questions.</p><div style=\"width:100%;overflow:hidden;\"><iframe src=\"https://lucas1213wzy.github.io/xaikit-test-ui-apparatus/global/iframe.html?appId=mushrooms&amp;instanceId=0&amp;modelName=mlp&amp;xaiType=LR&amp;LRVariant=dense&amp;showPrediction=1\" data-natural-width=\"1280\" data-natural-height=\"900\" style=\"width:100%;height:700px;border:1px solid #ccc;\" allow=\"fullscreen\"></iframe></div>",
        "QuestionText_Unsafe": "<div><strong>Practice trial 1 of 10</strong> — instance 0</div><p>This is a practice round: you will see feedback after answering. Study the interface below, then answer the questions.</p><div style=\"width:100%;overflow:hidden;\"><iframe src=\"https://lucas1213wzy.github.io/xaikit-test-ui-apparatus/global/iframe.html?appId=mushrooms&amp;instanceId=0&amp;modelName=mlp&amp;xaiType=LR&amp;LRVariant=dense&amp;showPrediction=1\" data-natural-width=\"1280\" data-natural-height=\"900\" style=\"width:100%;height:700px;border:1px solid #ccc;\" allow=\"fullscreen\"></iframe></div>",
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        },
        "Language": [],
        "ChoiceOrder": [],
        "Validation": {
          "Settings": {
            "Type": "None"
          }
        },
        "NextChoiceId": 1,
        "NextAnswerId": 1,
        "QuestionJS": "Qualtrics.SurveyEngine.addOnload(function() {\n  var qc = this.getQuestionContainer();\n  var frames = qc.querySelectorAll('iframe[data-natural-width]');\n  for (var i = 0; i < frames.length; i++) {\n    (function(f) {\n      var nw = parseInt(f.getAttribute('data-natural-width'), 10) || 1280;\n      var nh = parseInt(f.getAttribute('data-natural-height'), 10) || 900;\n      var wrap = f.parentElement;\n      function fit() {\n        var w = wrap.clientWidth || qc.clientWidth || nw;\n        var s = Math.min(1, w / nw);\n        f.style.width = nw + 'px';\n        f.style.height = nh + 'px';\n        f.style.transform = 'scale(' + s + ')';\n        f.style.webkitTransform = 'scale(' + s + ')';\n        f.style.transformOrigin = '0 0';\n        f.style.webkitTransformOrigin = '0 0';\n        wrap.style.height = Math.ceil(nh * s) + 'px';\n        wrap.style.overflow = 'hidden';\n      }\n      fit();\n      window.addEventListener('resize', fit);\n    })(frames[i]);\n  }\n});"
      }
    },
