# Per-study artifacts written by the study server (server/README.md).
server_runs/

# Raw human participant data — kept out of the repo. assets/human_data/ is
# otherwise the anonymized, renumbered output of build_human_data.py and is
# meant to be committed; these specific files are raw pre-anonymization
# sources (or, for participant_id_map.csv, the de-anonymization key itself)
# that happen to live in the same tree and must never ship.
assets/human_data/participant_id_map.csv
assets/human_data/CoAX/coax-3-datasets-user-responses.csv
assets/human_data/CoXAM/coxam-mushrooms-wine-quality-user-responses.csv
assets/human_data/CoXAM/overall_counterfactual_resultsv0.2.xlsx
src/cognitive_models/CoXAM/datasets/mushrooms and wine quality user data v0.1.csv
src/cognitive_models/CoXAM/datasets/mushrooms and wine quality v0.2.jmp

# Dev-only notebooks -- not part of the service, not meant to ship.
tutorials/experiment_output/\[Fei\]_CoXAM_updated_tutorial.ipynb
tutorials/sample_tutorials/

# Scratch backups made mid-session, and session handoff notes -- not meant
# to be part of the repo's history.
*.pre-apparatus.bak
SIM2REAL_ATTRIBUTION_SUM_HANDOFF.md
COXAM_INTEGRATION_HANDOFF.md

# Regenerated notebook-run output, not source.
tutorials/rules_weights_output/

# Built documentation — regenerated by docs/build_docs.py, deployed by CI.
site/

# Local deployment notes. These name real hosts and addresses, which this
# public repository should not carry; deploy/README.md holds the generic
# instructions instead.
deploy/SETUP.md
deploy/*.local.md
